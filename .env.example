# Followthrough configuration. Copy to .env and fill in what you need.

# --- LLM (one required) ---
ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# --- Who the AI works for ---
# Framed into every extraction, email and release-matching prompt.
PRODUCT_NAME=
# PRODUCT_DESCRIPTION=a payroll platform for SMBs

# --- Access ---
# Comma-separated email domains allowed to hold accounts. Unset = any email.
# ALLOWED_EMAIL_DOMAINS=acme.com
# Optional shared team password (any allowed email + this signs in as a member).
# If you set this, ALSO set ALLOWED_EMAIL_DOMAINS, or anyone with the password
# can sign in with any email.
# ACCESS_PASSWORD=

# --- GitHub ---
# owner/name repo whose releases are matched to client asks. Unset = poller off.
# RELEASE_REPO=acme/product
# GITHUB_READ_TOKEN=
# Repos the tool may create issues in (comma-separated). Unset = copy-paste only.
# WRITABLE_REPOS=acme/product
# GITHUB_WRITE_TOKEN=
# Orgs never written to, even if listed above.
# BLOCKED_ORGS=

# --- Public demo (read-only, fictional data) ---
# DEMO_MODE=true
# DEMO_ASK_PER_HOUR=10          # Ask questions per visitor IP per hour
# LLM_DAILY_BUDGET_USD=5        # hard daily AI spend cap (recommended for any public deploy)

# --- Optional ---
# PORT=4500
# DEEPGRAM_API_KEY=
# DEEPGRAM_KEYTERMS=
# DIGEST_WEBHOOK_URL=
# WATCH_DIR=
# ADMIN_EMAIL=admin@acme.com   # used by `bun run seed` when no email argument is given
