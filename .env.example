# Followthrough configuration. Copy to .env and fill in what you need.

# --- Database and files (Vercel + Supabase fill these in automatically) ---
# Postgres. On Supabase use the pooled (transaction mode) URL.
DATABASE_URL=
# Files go to Supabase Storage when both are set; otherwise to BLOB_DIR on disk.
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# STORAGE_BUCKET=followthrough
# Optional: run inside a separate Postgres schema (smoke tests, previews).
# DB_SCHEMA=

# --- LLM (one required) ---
# Gemini is used when it is the only key, or with LLM_PROVIDER=gemini.
GEMINI_API_KEY=
# Models tried in order; a model whose daily quota is used up is skipped until tomorrow.
# GEMINI_MODELS=gemini-3.6-flash,gemini-3-flash-preview,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-flash-lite-latest
# GEMINI_PRICES=gemini-3.6-flash=0.3/2.5   # per-model USD per million tokens (in/out), for the budget
# GEMINI_PRICE_IN_PER_M=      # USD per million input tokens, for LLM_DAILY_BUDGET_USD
# GEMINI_PRICE_OUT_PER_M=
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=

# --- Scheduled work (Vercel cron) ---
# Any long random string; Vercel sends it to /api/cron/daily. Unset = cron refuses to run.
CRON_SECRET=

# --- Who the AI works for ---
# Framed into every extraction, email and release-matching prompt.
PRODUCT_NAME=
# PRODUCT_DESCRIPTION=a payroll platform for SMBs

# --- Access ---
# Comma-separated email domains allowed to hold accounts. Unset = any email.
# ALLOWED_EMAIL_DOMAINS=acme.com
# Optional shared team password (any allowed email + this signs in as a member).
# If you set this, ALSO set ALLOWED_EMAIL_DOMAINS, or anyone with the password
# can sign in with any email.
# ACCESS_PASSWORD=

# --- GitHub ---
# owner/name repo whose releases are matched to client asks. Unset = poller off.
# RELEASE_REPO=acme/product
# GITHUB_READ_TOKEN=
# Repos the tool may create issues in (comma-separated). Unset = copy-paste only.
# WRITABLE_REPOS=acme/product
# GITHUB_WRITE_TOKEN=
# Orgs never written to, even if listed above.
# BLOCKED_ORGS=

# --- Public demo (read-only, fictional data) ---
# DEMO_MODE=true
# DEMO_ASK_PER_HOUR=10          # Ask questions per visitor IP per hour
# DEMO_ASK_GLOBAL_PER_HOUR=200  # Ask questions per hour across all visitors
# LLM_DAILY_BUDGET_USD=5        # hard daily AI spend cap in USD; defaults to 5 whenever an AI key is set

# --- Behind a proxy ---
# Proxies in front of the server that append to X-Forwarded-For (Railway,
# Render, Fly: 1). Used for login lockout and demo rate limits. 0 = ignore XFF.
# TRUSTED_PROXY_HOPS=1
# Only if the server is reachable solely through Cloudflare:
# TRUST_CF_CONNECTING_IP=true

# --- Optional ---
# PORT=4500
# Transcription of uploaded audio (required for audio on Vercel; without it, paste transcripts).
# DEEPGRAM_API_KEY=
# DEEPGRAM_KEYTERMS=
# DIGEST_WEBHOOK_URL=
# ADMIN_EMAIL=admin@acme.com   # used by `bun run seed` when no email argument is given
