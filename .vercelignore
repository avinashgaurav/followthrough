# Never upload local secrets or data to a Vercel build.
.env
.env.*
!.env.example
data/
node_modules/
web/node_modules/
web/dist/
extension/node_modules/
.gstack/
.design-shots/
# Not used by the build or at runtime (seed-demo reads demo/ from a local checkout).
# Anchored to the repo root: an unanchored `demo/` also matched web/src/demo/,
# which the static demo build imports, and broke the followthrough-demo project.
/design-reference/
/evals/
/demo/
