{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "bunVersion": "1.x",
  "installCommand": "bun install --frozen-lockfile && cd web && bun install --frozen-lockfile",
  "buildCommand": "bun run db:migrate && cd web && bun run build",
  "outputDirectory": "web/dist",
  "functions": {
    "api/server.ts": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/server?__path=/api/:path*" },
    { "source": "/share/:path*", "destination": "/api/server?__path=/share/:path*" },
    { "source": "/((?!api/|share/|assets/).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/cron/daily", "schedule": "30 3 * * *" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] }
  ]
}
